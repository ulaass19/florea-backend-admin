// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  image       String?

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  products ProductCategory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  subtitle    String?
  description String?
  flowerName  String?
  heroImage   String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  stockEnabled  Boolean @default(false)
  stockQuantity Int     @default(0)

  seoTitle       String?
  seoDescription String?

  categories  ProductCategory[]
  collections ProductCollection[]
  images      ProductImage[]
  sizes       ProductSize[]
  wraps       ProductWrap[]
  cards       ProductCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

model ProductCategory {
  productId  String
  categoryId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([categoryId])
}

model ProductCollection {
  productId    String
  collectionId String

  sortOrder Int @default(0)

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([productId, collectionId])
  @@index([collectionId])
  @@index([collectionId, sortOrder])
}

model ProductImage {
  id        String @id @default(cuid())
  productId String

  url       String
  alt       String?
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([sortOrder])
}

model ProductSize {
  id        String @id @default(cuid())
  productId String

  name  String?
  count Int
  price Decimal @db.Decimal(10, 2)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, count])
  @@index([productId])
}

model ProductWrap {
  id        String @id @default(cuid())
  productId String

  name       String
  image      String?
  extraPrice Decimal @default(0) @db.Decimal(10, 2)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductCard {
  id        String @id @default(cuid())
  productId String

  name       String
  extraPrice Decimal @default(0) @db.Decimal(10, 2)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Collection {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  subtitle    String?
  description String?
  image       String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  sortOrder Int @default(0)

  seoTitle       String?
  seoDescription String?

  products ProductCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
  @@index([createdAt])
}

model Balloon {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  subtitle    String?
  description String?
  heroImage   String?

  isActive   Boolean @default(true)
  isFeatured Boolean @default(false)

  seoTitle       String?
  seoDescription String?

  images   BalloonImage[]
  variants BalloonVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

model BalloonImage {
  id        String @id @default(cuid())
  balloonId String

  url       String
  alt       String?
  sortOrder Int    @default(0)

  balloon Balloon @relation(fields: [balloonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([balloonId])
  @@index([sortOrder])
}

model BalloonVariant {
  id        String @id @default(cuid())
  balloonId String

  name  String?
  color String?
  size  String?

  heliumIncluded Boolean @default(false)

  price Decimal @db.Decimal(10, 2)

  stockEnabled  Boolean @default(false)
  stockQuantity Int     @default(0)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  balloon Balloon @relation(fields: [balloonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([balloonId])
  @@index([isActive])
  @@index([sortOrder])
}